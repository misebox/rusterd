#!/bin/bash
# Publish the wasm package to npm. The version comes from Cargo.toml.
#
#   bin/publish         # run the checks and the build, then stop
#   bin/publish --yes   # same, then actually publish

set -euo pipefail
cd "$(dirname "$0")/.."

version=$(grep -m1 '^version = ' Cargo.toml | cut -d'"' -f2)
if [ -z "$version" ]; then
    echo "Could not read version from Cargo.toml" >&2
    exit 1
fi

if [ -n "$(git status --porcelain)" ]; then
    echo "Working tree is dirty. Commit or stash before publishing." >&2
    exit 1
fi

if npm view "rusterd@${version}" version >/dev/null 2>&1; then
    echo "rusterd@${version} is already on npm. Bump the version in Cargo.toml." >&2
    exit 1
fi

cargo test
wasm-pack build --target web

echo
echo "Ready to publish rusterd@${version} from pkg/"
if [ "${1:-}" != "--yes" ]; then
    echo "Nothing published. Re-run with --yes to publish."
    exit 0
fi

wasm-pack publish

echo
echo "Published rusterd@${version}. Tag the release with:"
echo "  git tag v${version} && git push origin v${version}"
